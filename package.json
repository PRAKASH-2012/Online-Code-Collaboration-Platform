{
  "name": "codesync-ai",
  "version": "1.0.0",
  "description": "CodeSync AI - Intelligent Real-Time Online Code Collaboration Platform",
  "main": "server/server.js",
  "scripts": {
    "setup": "npm install && npm install --prefix server",
    "start": "node server/server.js",
    "full": "npm run build && npm start",
    "server": "node server/server.js",
    "client": "vite --host localhost",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node server/utils/seedRunner.js",
    "build": "vite build"
  },
  "keywords": [
    "real-time",
    "collaboration",
    "monaco-editor",
    "socket.io",
    "ai-assistant",
    "yjs",
    "crdt",
    "ide",
    "react",
    "nodejs",
    "black-and-gold"
  ],
  "author": "CodeSync AI Team",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.20.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.2.1",
    "socket.io-client": "^4.8.3"
  }
}
