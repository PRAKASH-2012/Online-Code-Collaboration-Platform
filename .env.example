# CodeSync AI - Environment Configuration

# Server Port & URL
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/codesync-ai

# JWT Secrets
JWT_SECRET=codesync_ai_super_secret_jwt_key_2026_black_and_gold
JWT_REFRESH_SECRET=codesync_ai_super_secret_refresh_jwt_key_2026

# AI Assistant API Key (Google Gemini API or Custom Provider)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Isolated Code Execution API Key (Judge0 RapidAPI or Self-hosted Judge0)
JUDGE0_API_KEY=your_judge0_api_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# GitHub Integration OAuth App Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Cloudinary / Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
